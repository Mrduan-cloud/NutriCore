# ====== App ======
APP_NAME=NutriCore
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["*"]

# ====== Security (生产必须改) ======
JWT_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 每用户独立口令(bcrypt)+ 角色化 JWT。以下仅用于「启动 seed」与登录保护:
# - DEMO_PASSWORD: 启动时为演示人设(李哲/林悦)设置的口令,仅体验用
# - ADMIN_USERNAME/ADMIN_PASSWORD: 启动时引导的管理员账号(生产务必改 ADMIN_PASSWORD)
# - 连续失败 N 次锁定 M 分钟,挡暴力撞库
# APP_ENV=prod 时,若 JWT_SECRET_KEY/ADMIN_PASSWORD/MYSQL_PASSWORD 仍是默认值 → 拒绝启动
DEMO_PASSWORD=nutricore2024
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nutricore-admin-2024
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ====== LLM（私有化优先，三档同走 OpenAI 兼容协议，切换只改 base_url/model/key）======
# ① vLLM（GPU 生产私有化，默认）：compose `vllm` service，Qwen2.5-32B-AWQ + TP=2
#    docker compose --profile gpu up -d   启动细节见 docs/DEPLOYMENT.md §2.5
# ② Ollama（CPU 本地开发，无显卡可跑）：见文件末尾「开发机替代方案」
# ③ 云 API 托底（DeepSeek 等）：LLM_BASE_URL=https://api.deepseek.com/v1 · LLM_MODEL=deepseek-chat
LLM_BASE_URL=http://vllm:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.3

# ---- 多 LLM 适配层 (v1.1.0):provider 选择 ----
# LLM_PROVIDER=openai    → 走上面 LLM_* 的 OpenAI 兼容协议(默认,vLLM/Ollama/DeepSeek/Qwen/OpenAI)
# LLM_PROVIDER=anthropic → 走下面 ANTHROPIC_* 的原生 Anthropic Messages API
#   现代 Claude(Opus 4.8/4.7)拒绝 temperature → 适配层不透传,靠 prompt 引导。
#   ANTHROPIC_BASE_URL 留空=官方 api.anthropic.com;设值=自建代理/网关。
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=8192

# ====== Embedding & Reranker ======
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
EMBEDDING_DIM=1024
MODEL_CACHE_DIR=/app/.cache/models
# RAG 精排提速旋钮(CPU 上 Cross-Encoder 是首 token 前的主要阻塞)
#   RAG_RERANK_ENABLED=false → 跳过精排、走 RRF 召回顺序 = 最快(相关性排序略糙)
#   RAG_RERANK_MAX_CANDIDATES → 送入精排的候选上限,砍小即提速
RAG_RERANK_ENABLED=true
RAG_RERANK_MAX_CANDIDATES=8

# ====== Milvus ======
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_FOOD=food_kb
MILVUS_COLLECTION_GUIDE=dietary_guide_kb

# ====== MySQL ======
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=nutricore
MYSQL_PASSWORD=changeme
MYSQL_DB=nutricore
MYSQL_ROOT_PASSWORD=root

# ====== Redis ======
REDIS_URL=redis://redis:6379/0

# ====== MinIO ======
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nutricore
MINIO_SECURE=false

# ====== Dify (可选 - 数据洞察可视化编排) ======
DIFY_API_BASE=http://dify-api:8080/v1
DIFY_API_KEY=
DIFY_WORKFLOW_ID=nl2sql_insight

# ====== Vanna.ai (可选) ======
VANNA_API_KEY=
VANNA_MODEL=nutricore-sql

# ====== Observability ======
METRICS_ENABLED=true
METRICS_PATH=/metrics
SENTRY_DSN=

# ====== 没有 GPU 的开发机替代方案：Ollama（CPU 可跑，取消注释覆盖即可）======
# 先拉模型，二选一：
#   宿主直跑：  ollama pull qwen2.5:3b-instruct          → base_url 用 host.docker.internal:11434
#   compose：  docker compose --profile local-llm up -d
#              docker compose exec ollama ollama pull qwen2.5:3b-instruct  → base_url 用 ollama:11434
# qwen2.5:3b-instruct 本地实测端到端 NL2SQL 准确率 = 1.00（gold 4 例）；7b 质量更稳但更慢更大。
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b-instruct
